{"item_id": "mf-units-01", "payload_sha256": "720a46c832e8261189c48ca0552ae267278c40ba65187b36d9d278f8ae626826", "transcript_sha256": "a7d10095ab7c8a0504e57f6479be013ca6dff3bdc3c82587e20e1ae73d3f7e06", "linter_verdict": "clean", "execution_constraint_audit": "clean", "checker_verdict": "PASS", "covariates": {"locality_hops": 2, "files_spanned": 3, "distractor_count": 1, "cue_directness": "direct"}, "defect_keys": ["by 100", "divide by 100", "as a fraction", "percent as a fraction", "would compute"], "item_class": "multi_file", "defect_class": "units", "size_bytes": 2476, "author_model": "claude-sonnet-5", "checker_model": "claude-opus-4-8", "attempt": 1, "review_transcript_sha256": "6a2c5ac613ecab456d755729488b74065ad6eda2e57c3ad5b2a4f6e15d683c3c", "audit_transcript_sha256": "8798ae8b24e2a9ddf7e58ae5851d01a1f16541b3e40acd5e048e4ad1578c0c50", "blind_review": {"defect_found": true, "defect_class": "units", "description": "apply_discount treats discount_percent as a fraction, multiplying by (1 - discount_percent), but the docstring and callers pass a percentage (e.g. 15 for 15%). It should divide by 100 like apply_tax does; as written a 15% discount subtracts 1500% and yields a huge negative amount.", "confidence": "high", "keys_matched": ["by 100", "divide by 100", "as a fraction", "percent as a fraction"]}, "metadata_audit": {"keys_accurate": true, "covariates_sane": true, "single_defect": true, "notes": ""}}
